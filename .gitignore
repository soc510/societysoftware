# CakePHP 3

/vendor/*
/config/app.php

/tmp/cache/models/*
!/tmp/cache/models/empty
/tmp/cache/persistent/*
!/tmp/cache/persistent/empty
/tmp/cache/views/*
!/tmp/cache/views/empty
/tmp/sessions/*
!/tmp/sessions/empty
/tmp/tests/*
!/tmp/tests/empty

/logs/*
!/logs/empty

# CakePHP 2

/app/tmp/*
# Trailing * on purpose. These hold live credentials, and the servers carry
# hand-made copies next to them - "database.php1", "database.php test",
# "core.php.bak". Without the wildcard those copies are not ignored, and a
# `git add .` run on a server commits the live database password.
/app/Config/core.php*
/app/Config/database.php*
/vendors/*

# Leftovers of the original manual upload, ~594MB, and scratch files people
# drop in the public webroot. Neither belongs in the repo.
/app/archive.zip
/app/webroot/phptest-*
