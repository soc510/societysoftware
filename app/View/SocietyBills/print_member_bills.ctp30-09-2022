function firstLetterZero($number){
    $splitedNo = str_split($number);
    if($splitedNo[0] == 0){
        unset($splitedNo[0]);
    }
    $removedArray = array_values($splitedNo);
    $str = implode($removedArray);    
    return $str;
}

