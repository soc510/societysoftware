ion value=''> Select Particular</option>");                     $('#particular-select').append('<option value= new> Add New Particular</option>');                                     $('#notes-select').append("<option value='' > Select Notes</option>");                    $('#notes-select').append('<option value= new> Add New Notes</option>');                    $.each(resp.societyPayments,function(idx,obj){                        let notes = obj.SocietyPayment.notes;                        let particulars = obj.SocietyPayment.particulars;                                                if(obj.SocietyPayment.particulars !== ''){                            $('#particular-select').append('<option value='+particulars+'>'+particulars +'</option>');                         }                                                if(obj.SocietyPayment.notes !== ''){                            $('#notes-select').append('<option value='+notes+'>'+notes +'</option>');                              }                                                            });                                   }            }        });    }function setToAddNewParticulars(parttext) {    if(parttext == 'new'){        $('#particular-text').val('');    }    else{        $('#particular-text').val($('#particular-select').val());    }        showParicularTextBox();}function enableParicularSelect(){    if($('#particular-text').val() === ''){        hideParicularTextBox();    }}function showParicularTextBox(){    $('#particular-select').hide();    $('#particular-select').val('');    $('#particular-text').show();}function hideParicularTextBox(){    $('#particular-select').show();    $('#particular-text').hide();}function showNotesTextBox(){    $('#notes-select').hide();    $('#notes-select').val('');    $('#notes-text').show();}function hideNotesTextBox(){    $('#notes-select').show();    $('#notes-text').hide();}function setToAddNotes(notestext) 