				$optionsSocietyOtherIncome['AND']['SocietyOtherIncome.payment_date'] = $dateTo;



				$optionsJournalVoucher['AND']['JournalVoucher.voucher_date'] = $dateTo;



				$optionsMemberBillGenerate['AND']['MemberBillGenerate.bill_generated_date'] = $dateTo;



			}



			//







			if ($isInBill == 0) {



				// get records from society_payments



				$this->loadModel('SocietyPayment');







				$societyPayments = $this->SocietyPayment->find('all', array('conditions' => $optionsSociety));



				if (!empty($societyPayments)) {



					foreach ($societyPayments as $paymentDetails) {



