        $ledgerData = json_decode($this->request['data'],true);
        //print_r($ledgerData);die;
        foreach ($ledgerData as $key=>$val){

            if (!empty($ledgerData['ledger_head_id_'.$val])){
                $ledgerIds[] = $val;
                $ledgerClosingData[$val]['ledger_head_id'] = $val;
                $ledgerClosingData[$val]['op_credit'] = $ledgerData['op_credit_'.$val];
                $ledgerClosingData[$val]['op_debit'] = $ledgerData['op_debit_'.$val];
                $ledgerClosingData[$val]['credit'] = 0;
