	function getChecqueReturnedData($socityBankId,$fromDate=null,$toDate=null,$societyMemberId=null,$societyId=null){
		$this->loadModel('ChequeReturnData');
		$conditions = (!is_null($socityBankId) && $socityBankId > 0) ? array('member_pay.society_bank_id' => $socityBankId) : array();
		if(!empty($fromDate) && !empty($toDate)){
			 $conditions['ChequeReturnData.cheque_return_date between ? and ?'] =  array($fromDate,$toDate);    
		}
		if(!is_null($societyMemberId)){
			$conditions['ChequeReturnData.member_id'] =  $societyMemberId;    
		}
		if(!is_null($societyMemberId)){
			$conditions['ChequeReturnData.society_id'] =  $societyId;    
		}
		return  $this->ChequeReturnData->find('all',array(
			'joins' => array(
				array(
					'table' => 'member_payments',
					'alias' => 'member_pay',
					'type' => 'INNER',
					'conditions' => array(
						'member_pay.cheque_reference_number = ChequeReturnData.cheque_no',
						'member_pay.member_id = ChequeReturnData.member_id',
						)
					)
				),
			   'conditions' => $conditions
			));
	}



