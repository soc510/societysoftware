	public function genrateMemberOpeningAccountbalance($societyId){
		$query = "select member_id,bill_generated_date,bill_due_date,case when principal_balance = 0.00 and interest_balance = 0.00 and tax_balance = 0.00 then balance_amount else principal_balance end as principal_balance,interest_balance,tax_balance from member_bill_summaries where id in (select max(id) from member_bill_summaries where member_id in(select id from members where society_id = $societyId) group by member_id)";
		$dbConnection = connectionManager::getDataSource('database201920');

		$closingBalData =  $dbConnection->query($query);
		
		return $closingBalData;
	}

