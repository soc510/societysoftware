			$optionsJournalVoucherCredit['OR']['JournalVoucher.voucher_date BETWEEN ? and ?'] = array($postData['payment_date'], $postData['payment_date_to']);
			$optionsMemberBillSummary['OR']['MemberBillSummary.bill_generated_date BETWEEN ? and ?'] = array($postData['payment_date'], $postData['payment_date_to']);
		} else if (isset($postData['payment_date']) && !empty($postData['payment_date'])) {
			$options['AND']['MemberPayment.payment_date'] = $postData['payment_date'];
			$optionsJournalVoucherDebit['AND']['JournalVoucher.voucher_date'] = $postData['payment_date'];
			$optionsJournalVoucherCredit['AND']['JournalVoucher.voucher_date'] = $postData['payment_date'];
