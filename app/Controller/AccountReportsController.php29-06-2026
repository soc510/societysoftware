	function evaluate($due,$operator,$amount){
		switch($operator){
			case '<' :
				return ($due < $amount);
				break;
			case '>':
				return ($due > $amount);
				break;
			case '>=':
				return ($due >= $amount);
				break;
			case '<=':
				return ($due <= $amount);
				break;        
			case '=':
				return ($due == $amount);
				break;        
			case '<>':
				return ($due != $amount);
				break;
			default :
				return null;
				break;                
		}
	}

