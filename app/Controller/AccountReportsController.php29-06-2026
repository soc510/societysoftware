	public function getPaymentDetailForPrevAndCurrentMonth($memberBillSummary,$openingBalance,$currentYear,$nextYear){
		$currentAndPrevBillData = [];
		$billTransactionDetails = [];
		$filteredMonth = $this->request->data['reqeust']['month'];

		if($filteredMonth < 4){
			$customerDate = "$nextYear-$filteredMonth-01";    
		}
		else{
			$customerDate = "$currentYear-$filteredMonth-01";    
		}
		
		$prevMonthData = [];
		$currentMonthData = [];

		if(!empty(($memberBillSummary))){
			$prevBillPrinciple = 0;
			$prevBillInterest = 0;
			$prevBillTax = 0;
			
			$totalPrinciPalPaid = 0;
			$totalInterestPaid = 0;
			$totalTaxPaid = 0;
			
			$totalBal = 0;
			foreach($memberBillSummary as $billData){
				$billDate = $billData['MemberBillSummary']['bill_generated_date'];
				$principle = $billData['MemberBillSummary']['monthly_principal_amount'];
				$tax = $billData['MemberBillSummary']['tax_total'];
				$interest = $billData['MemberBillSummary']['interest_on_due_amount'];
				
				$balAmt = $billData['MemberBillSummary']['balance_amount'];
				
				$principalPaid = $billData['MemberBillSummary']['principal_paid'];
				$taxPaid = $billData['MemberBillSummary']['tax_paid'];
				$interestPaid = $billData['MemberBillSummary']['interest_paid'];
				
				
				$billDueDate = $billData['MemberBillSummary']['bill_due_date'];
				$billNo = $billData['MemberBillSummary']['bill_no'];
				$billMonth = $billData['MemberBillSummary']['month'];
				
				$principle = $principle - $tax;
				
				if(strtotime($customerDate) > strtotime($billDate)){
					if($filteredMonth != 4 && $billMonth == 4) $principle = $principle+$openingBalance;
					$prevBillPrinciple = $prevBillPrinciple + $principle;
					$prevBillInterest = $prevBillInterest + $interest;
					$prevBillTax = $prevBillTax + $tax;
					
					$totalPrinciPalPaid =  $totalPrinciPalPaid + $principalPaid;
					$totalInterestPaid =  $totalInterestPaid + $interestPaid;
					$totalTaxPaid =  $totalTaxPaid + $taxPaid;
					
					$totalBal = ($balAmt < 0 ) ?  $totalBal + abs($balAmt): $totalBal;
					
					$currentAndPrevBillData['prev_bill_data']['principle'] = $prevBillPrinciple;
					$currentAndPrevBillData['prev_bill_data']['tax'] = $prevBillTax;
					$currentAndPrevBillData['prev_bill_data']['interest'] = $prevBillInterest;
					
					$currentAndPrevBillData['prev_bill_data']['principle_paid'] = $totalPrinciPalPaid;
					$currentAndPrevBillData['prev_bill_data']['tax_paid'] = $totalTaxPaid;
					$currentAndPrevBillData['prev_bill_data']['interest_paid'] = $totalInterestPaid;                    
					$currentAndPrevBillData['prev_bill_data']['total_bal_amt'] = $totalBal;   
				}
				
				if($filteredMonth == $billData['MemberBillSummary']['month']){
					if($filteredMonth == 4) $principle = $principle+$openingBalance;
					$currentAndPrevBillData['current_bill_data']['principle'] = $principle;
					$currentAndPrevBillData['current_bill_data']['tax'] = $tax;
					$currentAndPrevBillData['current_bill_data']['interest'] = $interest;
					$currentAndPrevBillData['current_bill_data']['bill_no'] = $billNo;
					$currentAndPrevBillData['current_bill_data']['bill_generated_date'] = $billDate;
					$currentAndPrevBillData['current_bill_data']['bill_due_date'] = $billDueDate;
				}
				
			}
		}
		
		return $currentAndPrevBillData;
	}
	
	public function getJvDetailsForGivenMonth($date,$journalVoucherData,$type){
		$jvTotalAmount = 0;
		$givenDataMonth= date('m',strtotime($date));
		$givenDateYear = date('Y',strtotime($date));  
		$jvText = ($type == 'Credit') ? 'jv_amount_credited' : 'jv_amount_debited';
		if(!empty($journalVoucherData)){   
			foreach($journalVoucherData as $data){
				$voucherDate = $data['JournalVoucher']['voucher_date'];
				$jvType = $data['JournalVoucher']['voucher_date'];
				$jvAmount = $data['JournalVoucher'][$jvText];
				$voucherDateMonth = date('m',strtotime($voucherDate));
				$voucherDateYear = date('Y',strtotime($voucherDate));                                                
				if($givenDateYear == $voucherDate && $givenDataMonth == $voucherDateMonth && $jvType== $type){
					$jvTotalAmount = $jvTotalAmount + $jvAmount;
				}
			}
		}
		
		return $jvTotalAmount;
		
	}    
	
	public function getPaymentForGivenMonth($date,$paymentData,$returnPaymentIds){
		$paidAmount = 0;
		$givenDataMonth= date('m',strtotime($date));
		$givenDateYear = date('Y',strtotime($date));        
		if(!empty($paymentData)){   
			foreach($paymentData as $data){
				$billPaidDate = $data['MemberPayment']['payment_date'];
				$paymentDateMonth = date('m',strtotime($billPaidDate));
				$paymentDateYear = date('Y',strtotime($billPaidDate));                       
				$paymentId = $data['MemberPayment']['id'];
				if(!in_array($paymentId,$returnedCheqPayId) && $givenDateYear == $paymentDateYear && $givenDataMonth == $paymentDateMonth){
					$amountPaid = $data['MemberPayment']['amount_paid'];
					$paidAmount = $paidAmount + $amountPaid;
				}
			}
		}

		return $paidAmount;
	}    
	
	public function getBillAmountForGivenMonth($date,$billData){
		$monthBillAmount = 0;
		$givenDataMonth= date('m',strtotime($date));
		$givenDateYear = date('Y',strtotime($date));        
		if(!empty($billData)){
			foreach($billData as $data){
				$billGeneratedDate = $data['MemberBillSummary']['bill_generated_date'];
				$billDateMonth = date('m',strtotime($billGeneratedDate));
				$billDateYear = date('Y',strtotime($billGeneratedDate));
				if($givenDateYear == $billDateYear && $givenDataMonth == $billDateMonth){
					$monthBillAmount = $data['MemberBillSummary']['monthly_amount'];            
					break;
				}
			}
		}
		return $monthBillAmount;
	}
	
