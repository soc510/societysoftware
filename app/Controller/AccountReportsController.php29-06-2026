	public function getTitleOfSubCategory($societyHeadSubCategory,$subHeadId){
		$subHead = '';
		if(!empty($societyHeadSubCategory)){
			foreach($societyHeadSubCategory as $key => $data){
				if($data['SocietyHeadSubCategory']['id'] == $subHeadId){
					$subHead = $data['SocietyHeadSubCategory']['title'];     break;       
				}
			}
		}
		
		return $subHead;
	}    







