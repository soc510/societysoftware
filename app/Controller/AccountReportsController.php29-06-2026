		} else if (isset($postData['payment_date_to']) && !empty($postData['payment_date_to'])) {
			$options['AND']['MemberPayment.payment_date'] = $postData['payment_date_to'];
			$optionsJournalVoucherDebit['AND']['JournalVoucher.voucher_date'] = $postData['payment_date_to'];
			$optionsJournalVoucherCredit['AND']['JournalVoucher.voucher_date'] = $postData['payment_date_to'];
			$optionsMemberBillSummary['AND']['MemberBillSummary.bill_generated_date'] = $postData['payment_date_to'];
		}

		$optionsMemberBillSummary['AND']['MemberBillSummary.member_id'] = $memberId;
		$memberBillAmount = $this->MemberBillSummary->find('first', array('conditions' => $optionsMemberBillSummary, 'fields' => array('sum(MemberBillSummary.monthly_bill_amount) as total_bill_amount')));
		if (!empty($memberBillAmount[0]['total_bill_amount'])) {
			$debit += $memberBillAmount[0]['total_bill_amount'];
		}
		$optionsJournalVoucherDebit['AND']['JournalVoucher.jv_debit_member_head_id'] = $memberId;
		$jvDebitPayments = $this->JournalVoucher->find('first', array('conditions' => $optionsJournalVoucherDebit, 'fields' => array('sum(JournalVoucher.jv_amount_debited) as total_amount_debited')));
		if (!empty($jvDebitPayments[0]['total_amount_debited'])) {
			$debit += $jvDebitPayments[0]['total_amount_debited'];
		}


		$options['AND']['MemberPayment.member_id'] = $memberId;
		$memberPaidAmount = $this->MemberPayment->find('first', array('conditions' => $options, 'fields' => array('sum(MemberPayment.amount_paid) as total_paid_amount')));
		if (!empty($memberPaidAmount[0]['total_paid_amount'])) {
			$credit += $memberPaidAmount[0]['total_paid_amount'];
		}

		$optionsJournalVoucherCredit['AND']['JournalVoucher.jv_credit_member_head_id'] = $memberId;
		$jvCreditPayments = $this->JournalVoucher->find('first', array('conditions' => $optionsJournalVoucherCredit, 'fields' => array('sum(JournalVoucher.jv_amount_credited) as total_amount_credited')));

		if (!empty($jvCreditPayments[0]['total_amount_credited'])) {
			$credit += $jvCreditPayments[0]['total_amount_credited'];
		}

		// cheque return amount of user
		$debit = $debit + $this->getMemberWiseChequeReturnData($memberId,$societyId);





		$transactions = array('debit' => $debit, 'credit' => $credit);
	   //  print_r($transactions);exit;



		return $transactions;



	}

